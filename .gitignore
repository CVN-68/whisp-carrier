# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
# Isolated environments for VAD models that cannot share the main one:
# inaSpeechSegmenter wants tensorflow[and-cuda], funasr-onnx pins numpy<=1.26.4.
# See HANDOVER 測定結果 #18.
_venv*/

# PyInstaller. The -full variants come from building with WHISP_CARRIER_FULL=1
# and a separate --distpath/--workpath, so that verifying it does not overwrite
# the normal build.
build/
dist/
build-full/
dist-full/
# WHISP_CARRIER_SLIM=1 (torch dropped). Same reason for a separate distpath:
# verifying it must not overwrite the build the released archive came from.
build-slim/
dist-slim/
*.manifest

# IDE
.vscode/
.idea/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Models (large files)
_models/
*.onnx
*.ckpt
*.bin
*.pt

# Temp files. No trailing slash: throwaway probes get written as _tmp_foo.py /
# _tmp_foo.log at the repo root too, and "_tmp*/" only matched directories, so
# those showed up as untracked and looked committable.
*.tmp
*.bak
_tmp*

# Test files
make_test_audio.py
test.wav
test_speech.wav
test_speech.srt

# Evaluation material and results.
#
# Do not commit these even though MEASUREMENTS.md cites _eval/score-*.txt by
# name throughout. Those reports are not just numbers: the example spans quote
# the broadcaster's caption text and the recognised dialogue verbatim, and the
# file stems are broadcast datetime ids. Publishing them would publish the
# recordings' contents, and invite requests for material that cannot be shared.
#
# The cost is accepted deliberately: the cited reports do not reach anyone else,
# so the figures in MEASUREMENTS.md cannot be independently verified. That is a
# property of the source material, not an oversight.
_eval/
sample/

# Third-party binaries fetched for the build (ffmpeg). The binary itself is not
# ours to commit, but the record of what went in has to survive, so
# PROVENANCE.txt is tracked. Re-including a single file needs the directory to
# stay visible to git, hence the three-step pattern rather than a bare _tools/.
_tools/*
!_tools/ffmpeg/
_tools/ffmpeg/*
!_tools/ffmpeg/PROVENANCE.txt
!_tools/rnnoise/
_tools/rnnoise/*
!_tools/rnnoise/PROVENANCE.txt